# Copy to .dev.vars for the Vinext/Cloudflare local runtime.
# For a Node host, use .env.local. Never commit actual values.
APP_BACKEND=supabase
APP_URL=http://127.0.0.1:5173
SUPABASE_URL=https://fdfgglmknbmcbjuxuwoq.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# SERVER ONLY. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Direct PostgreSQL settings for external administration / migration tools.
# The web runtime uses the Supabase API settings above, not a raw TCP driver.
PGHOST=db.fdfgglmknbmcbjuxuwoq.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=YOUR_DATABASE_PASSWORD
PGSSLMODE=verify-full
